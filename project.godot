; Engine configuration file.
; Edit through the Godot editor whenever possible.

config_version=5

[application]

config/name="Guildmaster Deckbuilder"
config/version="0.16.0"
run/main_scene="res://scenes/boot/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.035, 0.047, 0.059, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.025, 0.033, 0.043, 1)

[input]

skip_animation={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32)]
}
show_details={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":73,"unicode":105)]
}
